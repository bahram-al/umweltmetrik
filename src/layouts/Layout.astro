---
import '../styles/site.css';
import '../styles/home.css';
import '../styles/glass.css';
import '../styles/sticky-header.css';
import '../styles/mobile-navigation.css';
import Brand from '../components/Brand.astro';
import {contactConfig} from '../data/contact-config';
import {href,label,type Lang,type Page} from '../data/site';
interface Props {title:string;lang:Lang;page:Page;id?:string;hero?:boolean;}
const {title,lang,page,id,hero=true}=Astro.props;
const isHome=page==='home'&&hero;
const nav:Page[]=['home','services','quality','labs','about','contact'];
const other=lang==='de'?'en':'de';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content={isHome?'#0d303a':'#fafbf9'} />
<meta name="robots" content="noindex,nofollow,noarchive" />
<meta name="description" content={lang==='de'?'UmweltMetrik: Umweltprobenahme, Monitoring und geologische Feldarbeit. Fachinformationen für Wasser, Boden und Abfall.':'UmweltMetrik: environmental sampling, monitoring and geological fieldwork. Technical information for water, soil and waste.'} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=original-u" />
<link rel="preload" href="/fonts/jost-400.ttf" as="font" type="font/ttf" crossorigin />
<title>{title} | UmweltMetrik</title>
</head>
<body class:list={[isHome?'home-page':'inner-page']}>
<a class="skip-link" href="#main">{lang==='de'?'Zum Inhalt springen':'Skip to content'}</a>
<aside class="preview-banner" aria-label={lang==='de'?'Hinweis zur Testversion':'Test version notice'}><strong>{lang==='de'?'Testversion · Website im Aufbau':'Test version · Website under development'}</strong><span>{lang==='de'?`Inhalte vorläufig. Rechtstexte noch unvollständig.${contactConfig.enabled?'':' Formular ohne Versand.'}`:`Content is provisional. Legal and privacy notices are still incomplete.${contactConfig.enabled?'':' The form does not send.'}`}</span></aside>
<header class="site-header" id="header"><div class="header-inner">
<a class="wordmark" href={href('home',lang)} aria-label={lang==='de'?'UmweltMetrik – Startseite':'UmweltMetrik – home'}><Brand markId="brand-header-cut" /></a>

<nav class="desktop-nav" aria-label={lang==='de'?'Hauptnavigation':'Main navigation'}>{nav.map(n=><a href={href(n,lang)} aria-current={page===n?'page':undefined}>{n==='home'?'Home':n==='labs'?(lang==='de'?'Labore':'Laboratories'):label(n,lang)}</a>)}<a class="language-link" href={href(page,other,id)} lang={other} aria-label={other==='de'?'Deutsch':'English'}>{other==='de'?'DE':'EN'}</a></nav>
<div class="header-actions"><button class="menu-toggle magnetic" id="menu-toggle" type="button" aria-controls="menu-dialog" aria-expanded="false" aria-label={lang==='de'?'Menü öffnen':'Open menu'}><span class="dot-group" aria-hidden="true"><i></i><i></i><i></i></span></button></div>
</div></header>
<dialog id="menu-dialog" aria-label={lang==='de'?'Navigation':'Navigation'}>
<div class="menu-sheet"><div class="menu-top"><a class="wordmark" href={href('home',lang)} aria-label="UmweltMetrik"><Brand markId="brand-menu-cut" /></a><button class="menu-close magnetic" type="button" aria-label={lang==='de'?'Menü schließen':'Close menu'}><span aria-hidden="true">×</span></button></div>
<div class="menu-body"><nav aria-label={lang==='de'?'Alle Seiten':'All pages'}>{nav.map(n=><a class="menu-link" href={href(n,lang)} aria-current={page===n?'page':undefined}>{n==='home'?'Home':label(n,lang)}</a>)}</nav><div class="menu-aside"><a href="mailto:info@umweltmetrik.de">info@umweltmetrik.de</a><a class="menu-language" href={href(page,other,id)} lang={other}>{other==='de'?'Deutsch':'English'}</a></div></div>
</div></dialog>
<main id="main" tabindex="-1"><slot /></main>
<footer class="site-footer"><div class="footer-top"><p>{lang==='de'?'Umweltprobenahme. Monitoring. Geologische Feldarbeit.':'Environmental sampling. Monitoring. Geological fieldwork.'}</p>{page!=='contact'&&<a class="footer-email" href="mailto:info@umweltmetrik.de">info@umweltmetrik.de</a>}</div><a class="footer-brand" href={href('home',lang)} aria-label={lang==='de'?'Zur Startseite':'Back to home'}><Brand large markId="brand-footer-cut" /></a><div class="footer-bottom"><span>{lang==='de'?'UmweltMetrik – Umweltprobenahme & Monitoring':'UmweltMetrik – Environmental sampling & monitoring'}</span><nav class="footer-links" aria-label={lang==='de'?'Rechtliches und Bildquellen':'Legal information and image credits'}><a class="footer-credits" href={href('credits',lang)}>{label('credits',lang)}</a><a href={href('imprint',lang)}>{label('imprint',lang)}</a><a href={href('privacy',lang)}>{label('privacy',lang)}</a></nav><span>© 2026 UmweltMetrik</span></div></footer>
<script>import '../scripts/site.js';</script>
</body>
</html>
